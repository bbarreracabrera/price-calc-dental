diff --git a/supabase/migrations/20261123_01_specialties_tracking_tables.sql b/supabase/migrations/20261123_01_specialties_tracking_tables.sql
new file mode 100644
index 0000000..e364849
--- /dev/null
+++ b/supabase/migrations/20261123_01_specialties_tracking_tables.sql
@@ -0,0 +1,86 @@
+-- =================================================================
+-- ShiningCloud Dental — Migración 2026-11-23 #1
+-- Tablas de especialidades con el nombre que usa el código
+-- (*_tracking). Idempotente: segura de re-ejecutar.
+--
+-- Historia: SPECIALTIES_TABLES.sql creaba estas tablas como
+-- *_tracking, pero PatientWorkspace y sus 3 tabs consultaban
+-- *_records (tablas inexistentes). Se estandariza el código a
+-- *_tracking; esta migración garantiza que existan con ese nombre.
+-- =================================================================
+
+CREATE EXTENSION IF NOT EXISTS pgcrypto;
+
+-- --- Ortodoncia ---
+CREATE TABLE IF NOT EXISTS public.orthodontics_tracking (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    patient_id UUID NOT NULL REFERENCES public.patients(id) ON DELETE CASCADE,
+    treatment_type TEXT,
+    torque_angulation TEXT,
+    archwire_type TEXT,
+    archwire_change_date DATE,
+    elastomers TEXT,
+    activation_notes TEXT,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    created_by TEXT
+);
+
+-- --- Implantología ---
+CREATE TABLE IF NOT EXISTS public.implantology_tracking (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    patient_id UUID NOT NULL REFERENCES public.patients(id) ON DELETE CASCADE,
+    implant_brand TEXT,
+    implant_model TEXT,
+    diameter TEXT,
+    length TEXT,
+    insertion_torque TEXT,
+    placement_date DATE,
+    stage TEXT,
+    abutment_type TEXT,
+    crown_type TEXT,
+    bone_graft BOOLEAN DEFAULT FALSE,
+    bone_graft_notes TEXT,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    created_by TEXT
+);
+
+-- --- Endodoncia ---
+CREATE TABLE IF NOT EXISTS public.endodontics_tracking (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    patient_id UUID NOT NULL REFERENCES public.patients(id) ON DELETE CASCADE,
+    tooth_number TEXT,
+    diagnosis TEXT,
+    working_length TEXT,
+    instruments_used TEXT,
+    irrigation_solution TEXT,
+    intracanal_medication TEXT,
+    obturation_material TEXT,
+    radiographic_follow_up BOOLEAN DEFAULT FALSE,
+    notes TEXT,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    created_by TEXT
+);
+
+CREATE INDEX IF NOT EXISTS idx_ortho_track_patient   ON public.orthodontics_tracking(patient_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_implanto_track_patient ON public.implantology_tracking(patient_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_endo_track_patient     ON public.endodontics_tracking(patient_id, created_at DESC);
+
+-- Índice que acelera el JOIN de las políticas (patient_id -> admin_email)
+CREATE INDEX IF NOT EXISTS idx_patients_id_admin ON public.patients(id, admin_email);
+
+-- =================================================================
+-- Respaldo si existiera una tabla *_records con datos reales
+-- =================================================================
+DO $$
+DECLARE t TEXT;
+BEGIN
+  FOREACH t IN ARRAY ARRAY['orthodontics','implantology','endodontics'] LOOP
+    IF EXISTS (SELECT 1 FROM information_schema.tables
+               WHERE table_schema='public' AND table_name = t || '_records') THEN
+      EXECUTE format(
+        'INSERT INTO public.%I_tracking SELECT * FROM public.%I_records ON CONFLICT DO NOTHING;',
+        t, t);
+      RAISE NOTICE 'Migrados datos de %_records a %_tracking', t, t;
+    END IF;
+  END LOOP;
+END $$;
diff --git a/supabase/migrations/20261123_02_specialties_rls.sql b/supabase/migrations/20261123_02_specialties_rls.sql
new file mode 100644
index 0000000..11c0155
--- /dev/null
+++ b/supabase/migrations/20261123_02_specialties_rls.sql
@@ -0,0 +1,68 @@
+-- =================================================================
+-- ShiningCloud Dental — Migración 2026-11-23 #2
+-- RLS de especialidades + esterilización, coherente con el
+-- modelo del resto del sistema (my_clinic_admin del sprint 1).
+-- Reemplaza apply_rls_specialties.sql, que solo contemplaba al
+-- admin y dejaba fuera al equipo (dentistas / asistentes).
+-- Idempotente.
+-- =================================================================
+
+ALTER TABLE public.orthodontics_tracking  ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.implantology_tracking  ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.endodontics_tracking   ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.sterilization_inventory ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.sterilization_cycles    ENABLE ROW LEVEL SECURITY;
+
+-- Limpiar políticas previas (nombres viejos y nuevos) para idempotencia
+DO $$
+DECLARE t TEXT;
+BEGIN
+  FOREACH t IN ARRAY ARRAY['orthodontics_tracking','implantology_tracking','endodontics_tracking'] LOOP
+    EXECUTE format('DROP POLICY IF EXISTS %L ON public.%I', t || '_select_team', t);
+    EXECUTE format('DROP POLICY IF EXISTS %L ON public.%I', t || '_all_owner', t);
+    EXECUTE format('DROP POLICY IF EXISTS %L ON public.%I', t || '_all_team', t);
+    EXECUTE format('DROP POLICY IF EXISTS %L ON public.%I', 'Clínicas pueden ver sus propios registros de ' ||
+      CASE t WHEN 'orthodontics_tracking' THEN 'ortodoncia' WHEN 'implantology_tracking' THEN 'implantología' ELSE 'endodoncia' END, t);
+  END LOOP;
+  EXECUTE 'DROP POLICY IF EXISTS "Clínicas pueden ver su propio inventario de esterilización" ON public.sterilization_inventory';
+  EXECUTE 'DROP POLICY IF EXISTS "Clínicas pueden ver sus propios ciclos de esterilización" ON public.sterilization_cycles';
+END $$;
+
+-- --- Tablas por paciente: acceso por membresía de clínica ---
+DO $$
+DECLARE t TEXT;
+BEGIN
+  FOREACH t IN ARRAY ARRAY['orthodontics_tracking','implantology_tracking','endodontics_tracking'] LOOP
+    EXECUTE format($f$
+      CREATE POLICY %I ON public.%I
+        FOR ALL TO authenticated
+        USING (
+          EXISTS (
+            SELECT 1 FROM public.patients p
+            WHERE p.id = %I.patient_id
+              AND p.admin_email = public.my_clinic_admin()
+              AND p.deleted_at IS NULL
+          )
+        )
+        WITH CHECK (
+          EXISTS (
+            SELECT 1 FROM public.patients p
+            WHERE p.id = %I.patient_id
+              AND p.admin_email = public.my_clinic_admin()
+              AND p.deleted_at IS NULL
+          )
+        );
+    $f$, t || '_all_team', t, t, t);
+  END LOOP;
+END $$;
+
+-- --- Esterilización: por clinic_email (mismo modelo que sprint 1) ---
+CREATE POLICY "ster_inventory_all_team" ON public.sterilization_inventory
+  FOR ALL TO authenticated
+  USING (clinic_email = public.my_clinic_admin())
+  WITH CHECK (clinic_email = public.my_clinic_admin());
+
+CREATE POLICY "ster_cycles_all_team" ON public.sterilization_cycles
+  FOR ALL TO authenticated
+  USING (clinic_email = public.my_clinic_admin())
+  WITH CHECK (clinic_email = public.my_clinic_admin());
diff --git a/supabase/migrations/20261123_03_lab_work_files.sql b/supabase/migrations/20261123_03_lab_work_files.sql
new file mode 100644
index 0000000..5cd919f
--- /dev/null
+++ b/supabase/migrations/20261123_03_lab_work_files.sql
@@ -0,0 +1,86 @@
+-- =================================================================
+-- ShiningCloud Dental — Migración 2026-11-23 #3
+-- lab_work_files: múltiples archivos por trabajo de laboratorio.
+-- (Versión ordenada del antiguo supabase_lab_files.sql, idéntica
+-- en comportamiento, con índice de auditoría por created_by.)
+-- Idempotente.
+-- =================================================================
+
+CREATE TABLE IF NOT EXISTS public.lab_work_files (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    lab_work_id TEXT NOT NULL REFERENCES public.lab_works(id) ON DELETE CASCADE,
+    file_path TEXT NOT NULL,
+    file_name TEXT NOT NULL,
+    file_size BIGINT,
+    content_type TEXT,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    created_by TEXT
+);
+
+ALTER TABLE public.lab_work_files ENABLE ROW LEVEL SECURITY;
+
+DROP POLICY IF EXISTS "lab_files_select_clinic" ON public.lab_work_files;
+DROP POLICY IF EXISTS "lab_files_select_lab" ON public.lab_work_files;
+DROP POLICY IF EXISTS "lab_files_insert_authorized" ON public.lab_work_files;
+DROP POLICY IF EXISTS "lab_files_delete_creator_or_admin" ON public.lab_work_files;
+
+CREATE POLICY "lab_files_select_clinic" ON public.lab_work_files
+  FOR SELECT TO authenticated
+  USING (
+    EXISTS (
+      SELECT 1 FROM public.lab_works lw
+      WHERE lw.id = lab_work_files.lab_work_id
+        AND (
+          lw.admin_email = auth.jwt()->>'email'
+          OR EXISTS (
+            SELECT 1 FROM public.team t
+            WHERE t.admin_email = lw.admin_email
+              AND t.data->>'email' = auth.jwt()->>'email'
+              AND t.deleted_at IS NULL
+          )
+        )
+    )
+  );
+
+CREATE POLICY "lab_files_select_lab" ON public.lab_work_files
+  FOR SELECT TO authenticated
+  USING (
+    EXISTS (
+      SELECT 1 FROM public.lab_works lw
+      WHERE lw.id = lab_work_files.lab_work_id
+        AND lw.lab_email = auth.jwt()->>'email'
+    )
+  );
+
+CREATE POLICY "lab_files_insert_authorized" ON public.lab_work_files
+  FOR INSERT TO authenticated
+  WITH CHECK (
+    EXISTS (
+      SELECT 1 FROM public.lab_works lw
+      WHERE lw.id = lab_work_files.lab_work_id
+        AND (
+          lw.admin_email = auth.jwt()->>'email'
+          OR lw.lab_email = auth.jwt()->>'email'
+          OR EXISTS (
+            SELECT 1 FROM public.team t
+            WHERE t.admin_email = lw.admin_email
+              AND t.data->>'email' = auth.jwt()->>'email'
+              AND t.deleted_at IS NULL
+          )
+        )
+    )
+  );
+
+CREATE POLICY "lab_files_delete_creator_or_admin" ON public.lab_work_files
+  FOR DELETE TO authenticated
+  USING (
+    created_by = auth.jwt()->>'email'
+    OR EXISTS (
+      SELECT 1 FROM public.lab_works lw
+      WHERE lw.id = lab_work_files.lab_work_id
+        AND lw.admin_email = auth.jwt()->>'email'
+    )
+  );
+
+CREATE INDEX IF NOT EXISTS idx_lab_work_files_work_id  ON public.lab_work_files(lab_work_id);
+CREATE INDEX IF NOT EXISTS idx_lab_work_files_creator  ON public.lab_work_files(created_by, created_at DESC);
